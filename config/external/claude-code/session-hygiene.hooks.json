{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR}/tools/scripts/host/record-claude-lifecycle.script.ts\" --workspace=\"${CLAUDE_PROJECT_DIR}\""
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR}/tools/scripts/host/record-claude-lifecycle.script.ts\" --workspace=\"${CLAUDE_PROJECT_DIR}\""
					},
					{
						"type": "mcp_tool",
						"server": "mcp-vertex",
						"tool": "mcp-vertex_memory_checkpoint_packet",
						"input": {
							"hostEvent": "pre-compact"
						}
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR}/tools/scripts/host/record-claude-lifecycle.script.ts\" --workspace=\"${CLAUDE_PROJECT_DIR}\""
					},
					{
						"type": "mcp_tool",
						"server": "mcp-vertex",
						"tool": "mcp-vertex_memory_checkpoint_packet",
						"input": {
							"maxDigestChars": 4000
						}
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR}/tools/scripts/host/record-claude-lifecycle.script.ts\" --workspace=\"${CLAUDE_PROJECT_DIR}\""
					}
				]
			}
		]
	}
}
