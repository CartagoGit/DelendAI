99: /** Brings every agent's notes from the forge, beside (not over) the local ones. */
100: export const fetchMakerNotes = async (
101: 	git: IGitRunner,
102: 	remote: string,
103: ): Promise<boolean> =>
104: 	(
105: 		await git([
106: 			'fetch',
107: 			'--quiet',
108: 			remote,
109: 			`+${MAKER_NOTES_PREFIX}*:${MAKER_NOTES_REMOTE_PREFIX}*`,
110: 		])
111: 	).ok;
112:
113: /**
114:  * The maker (and unit) each commit's notes name, local or fetched; a
115:  * commit nobody recorded is absent.
116:  */
117: export const makersOf = async (
118: 	git: IGitRunner,
119: 	commits: readonly string[],
120: ): Promise<ReadonlyMap<string, ICommitMaker>> => {
121: 	const makers = new Map<string, ICommitMaker>();
122: 	for (const commit of commits) {
123: 		const shown = await git([
124: 			'log',
125: 			'-1',
126: 			`--notes=${MAKER_NOTES_PREFIX}*`,
127: 			`--notes=${MAKER_NOTES_REMOTE_PREFIX}*`,
128: 			'--format=%N',
129: 			commit,
130: 		]);
131: 		const maker = shown.ok
132: 			? /^maker: (\S+)$/mu.exec(shown.output)?.[1]
133: 			: undefined;
134: 		const unit = shown.ok
135: 			? /^unit: (\S+)$/mu.exec(shown.output)?.[1]
136: 			: undefined;
137: 		if (maker !== undefined)
138: 			makers.set(commit, {
139: 				agent: maker,
140: 				...(unit === undefined ? {} : { unit }),
141: 			});
142: 	}
143: 	return makers;
144: };

