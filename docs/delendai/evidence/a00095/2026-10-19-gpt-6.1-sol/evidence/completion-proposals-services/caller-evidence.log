80: /**
81:  * Runs the SQL checks, then appends the storage-mode report. That report
82:  * needs no open database, so it is present even when the database is
83:  * missing, which is exactly when the configured mode matters most.
84:  */
85: export const runDbDoctorTool = (
86: 	options: IDbDoctorToolOptions,
87: ): IDbDoctorResult => {
88: 	const databasePath = resolveProposalsDbPaths(
89: 		options.workspaceRoot,
90: 	).databasePath;
91: 	const result = (options.runDoctor ?? runDbDoctor)({
92: 		workspaceRoot: options.workspaceRoot,
93: 		sqlitePath: databasePath,
94: 		checks: options.checks ?? DEFAULT_DOCTOR_CHECKS,
95: 	});
96: 	const storage = buildStorageModeCheck({
97: 		mode: resolveProposalIndexSource({ env: options.env ?? process.env }),
98: 		databasePath,
99: 		stats: getProposalIndexReadStats(),
100: 	});
101: 	return {
102: 		...result,
103: 		checks: [...result.checks, storage],
104: 		healthy: result.healthy && storage.severity === 'ok',
105: 	};

