275: /**
276:  * Every `*.md` under `dir`, with paths relative to `dir` so the
277:  * projection's `source_path` is workspace-shaped and stable across
278:  * machines (the logical digest depends on it).
279:  */
280: export const collectProposalMarkdown = (
281: 	dir: string,
282: ): readonly IReconcilerInputFile[] => {
283: 	if (!existsSync(dir)) return [];
284: 	const files: IReconcilerInputFile[] = [];
285: 	const walk = (current: string): void => {
286: 		for (const entry of readdirSync(current, { withFileTypes: true })) {
287: 			const full = join(current, entry.name);
288: 			if (entry.isDirectory()) {
289: 				walk(full);
290: 				continue;
291: 			}
292: 			if (!entry.isFile()) continue;
293: 			if (!entry.name.endsWith('.md')) continue;
294: 			files.push({
295: 				path: relative(dir, full),
296: 				raw: readFileSync(full, 'utf8'),
297: 			});
298: 		}
299: 	};
300: 	walk(dir);
301: 	return files.sort((a, b) => a.path.localeCompare(b.path));

