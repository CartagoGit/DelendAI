34: const safeSourcePath = (root: string, sourcePath: string): string => {
35: 	const absolute = isAbsolute(sourcePath)
36: 		? resolve(sourcePath)
37: 		: resolve(root, sourcePath);
38: 	const relativePath = relative(resolve(root), absolute);
39: 	if (relativePath.startsWith('..') || isAbsolute(relativePath)) {
40: 		throw new Error('quarantine source path escapes workspace root');
41: 	}
42: 	return absolute;
43: };
44:
45: export const runQuarantineRepair = (
46: 	options: IQuarantineToolOptions,
47: 	args: IQuarantineRepairArgs,
48: ): IQuarantineListOutput => {
49: 	const sqlitePath = resolveProposalsDbPaths(
50: 		options.workspaceRoot,
51: 	).databasePath;
52: 	if (!existsSync(sqlitePath)) return { entries: [], total: 0, runCount: 0 };
53: 	const driver = new ProposalsSqliteDriver({ path: sqlitePath });
54: 	try {
55: 		const repo = new QuarantineRepo(driver.handle);
56: 		const row = driver.handle
57: 			.query<
58: 				{
59: 					id: number;
60: 					source_path: string;
61: 					blob_sha: string;
62: 					run_id: number;
63: 				},
64: 				[number]
65: 			>(
66: 				`SELECT id, source_path, blob_sha, run_id
67: 				 FROM quarantine WHERE id = ?`,
68: 			)
69: 			.get(args.id);
70: 		if (!row) throw new Error(`Unknown quarantine id: ${String(args.id)}`);
71:
72: 		if (args.action === 'mark-ignored' || args.action === 'mark-resolved') {
73: 			repo.resolve({
74: 				id: args.id,
75: 				status: args.action === 'mark-ignored' ? 'ignored' : 'resolved',
76: 				resolvedBy: 'proposals_db_quarantine_repair',
77: 				resolutionNote: args.note ?? null,
78: 			});
79: 			return runQuarantineList(options);
80: 		}
81:
82: 		const sourcePath = safeSourcePath(
83: 			options.workspaceRoot,
84: 			row.source_path,
85: 		);
86: 		if (!existsSync(sourcePath)) {
87: 			throw new Error(
88: 				`quarantine source file is missing: ${row.source_path}`,
89: 			);
90: 		}
91: 		const raw = readFileSync(sourcePath, 'utf8');
92: 		const parsed = reconcileProposalMarkdown({
93: 			sourceCommit: 'quarantine-repair',
94: 			mode: 'incremental',
95: 			files: [{ path: row.source_path, raw, sha: row.blob_sha }],
96: 		});
97: 		const candidate = parsed.proposals[0];
98: 		if (candidate === undefined || parsed.quarantined.length > 0) {
99: 			throw new Error(
100: 				'current parser still rejects the quarantined file',
101: 			);
102: 		}
103: 		const outcome = new ProposalRepo(driver.handle).upsertProjection(
104: 			candidate,
105: 		);
106: 		if (outcome.kind === 'created' || outcome.kind === 'updated') {
107: 			new OutboxRepo(driver.handle).enqueue({
108: 				idempotencyKey: `quarantine-repair:${String(args.id)}:${String(outcome.proposal.revision)}`,
109: 				kind: 'regenerate-index',
110: 				payload: JSON.stringify({
111: 					uid: outcome.proposal.uid,
112: 					action: 'quarantine-repair',
113: 				}),
114: 			});
115: 		}
116: 		repo.resolve({
117: 			id: args.id,
118: 			status: 'resolved',
119: 			resolvedBy: 'proposals_db_quarantine_repair',
120: 			resolutionNote: args.note ?? 're-parsed successfully',
121: 		});
122: 		return runQuarantineList(options);
123: 	} finally {
124: 		driver.close();
125: 	}
126: };

