517: export const reconcileProposalsDb = (
518: 	input: IDbReconcileInput,
519: ): IDbReconcileOutput => {
520: 	const wallStart = Date.now();
521: 	const startedAt = input.now ?? wallStart;
522: 	const paths = resolveProposalsDbPaths(input.workspaceRoot);
523: 	const atCommit =
524: 		input.ref === undefined
525: 			? undefined
526: 			: collectProposalMarkdownAtCommit(
527: 					input.workspaceRoot,
528: 					input.proposalsDirAbs,
529: 					input.ref,
530: 				);
531: 	const sourceCommit =
532: 		atCommit?.sha ??
533: 		input.sourceCommit ??
534: 		resolveHeadCommit(input.workspaceRoot);
535: 	const dryRun = input.dryRun === true;
536: 	const created = !existsSync(paths.databasePath);
537: 	const files =
538: 		atCommit?.files ?? collectProposalMarkdown(input.proposalsDirAbs);
539: 	const preflight = preflightProposalFiles(files, sourceCommit);
540:
541: 	// Asked when the run is done, so a branch that moved while it read the
542: 	// commit is reported rather than silently left behind.
543: 	const driftAfterRun = (): IRefDrift | null =>
544: 		input.ref === undefined || atCommit === undefined
545: 			? null
546: 			: refDrift(input.workspaceRoot, input.ref, atCommit.sha);
547: 	const base = {
548: 		created,
549: 		dryRun,
550: 		databasePath: paths.databasePath,
551: 		stagingPath: paths.stagingPath,
552: 		statePath: paths.stateDir,
553: 		sourceCommit,
554: 		filesScanned: files.length,
555: 		filesReconciled: preflight.accepted.length,
556: 		excluded: preflight.excluded,
557: 		excludedCount: preflight.excluded.length,
558: 		startedAt,
559: 	};
560:
561: 	// Read the active database's authority BEFORE the staging copy is
562: 	// built, because that is the snapshot this promotion will be based
563: 	// on. Handing it to `applyValidatedCandidate` turns the promotion
564: 	// into a compare-and-swap: if another agent (or an incremental pass)
565: 	// advances the active database while this one is building, the write
566: 	// is refused instead of quietly replacing newer work with older.
567: 	//
568: 	// Omitting it — which this call site did while the seam existed
569: 	// unused — is choosing last-writer-wins, and a reconciliation that
570: 	// takes minutes on a repository several agents are editing is
571: 	// exactly where that loses somebody's work.
572: 	const expectedActiveSourceCommit =
573: 		input.expectedActiveSourceCommit !== undefined
574: 			? input.expectedActiveSourceCommit
575: 			: readActiveAuthority(paths.databasePath);
576:
577: 	const staged = reconcileShadowToStaging({
578: 		mode: 'shadow',
579: 		workspacePath: input.workspaceRoot,
580: 		sourceCommit,
581: 		sha: sourceCommit,
582: 		files: preflight.accepted,
583: 		now: startedAt,
584: 		...(input.driver !== undefined ? { driver: input.driver } : {}),
585: 	});

