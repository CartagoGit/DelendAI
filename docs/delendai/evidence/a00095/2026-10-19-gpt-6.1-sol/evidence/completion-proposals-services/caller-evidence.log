631: 		stagingPath: staged.stagingPath,
632: 		activePath: paths.databasePath,
633: 		sourceCommit,
634: 		expectedDigest: staged.stagingDigest,
635: 		expectedActiveSourceCommit,
636: 		now: startedAt,
637: 	});
638:
639: 	if (applied.status === 'ok') {
640: 		// The staging database has served its purpose. Leaving it behind
641: 		// would make the state dir look like a half-finished promotion.
642: 		removeStagingArtifacts(paths.stagingPath);
643: 		// What was set aside is kept where the proposals are read from: a
644: 		// read that rebuilds on its own has nobody to hand this list to.
645: 		recordSetAsideFiles({
646: 			databasePath: paths.databasePath,
647: 			files: proposalFilesSetAside(files, preflight.excluded),
648: 			now: startedAt,
649: 		});
650: 	}

