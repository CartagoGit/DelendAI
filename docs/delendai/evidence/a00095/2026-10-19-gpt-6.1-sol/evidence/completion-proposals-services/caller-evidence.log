bec5d5daf945df78464e4535c47628809ef8ca64:packages/proposals-sqlite/src/lib/set-aside.service.ts
22: export const recordSetAsideFiles = (input: {
23: 	readonly databasePath: string;
24: 	readonly files: readonly {
25: 		readonly path: string;
26: 		readonly blobSha: string;
27: 		readonly code: string;
28: 		readonly message: string;
29: 	}[];
30: 	readonly now: number;
31: }): number => {
32: 	const driver = new ProposalsSqliteDriver({ path: input.databasePath });
33: 	try {
34: 		const handle = driver.handle;
35: 		handle.transaction(() => {
36: 			const run = handle
37: 				.query<{ readonly id: number }, []>(
38: 					'SELECT id FROM reconciliation_runs ORDER BY id DESC LIMIT 1',
39: 				)
40: 				.get();
41: 			handle
42: 				.prepare("DELETE FROM quarantine WHERE status = 'pending'")
43: 				.run();
44: 			for (const file of input.files) {
45: 				handle
46: 					.prepare(
47: 						`INSERT INTO quarantine (
48: 							source_path, blob_sha, error_code, error_message,
49: 							run_id, status, created_at, updated_at
50: 						) VALUES (?, ?, ?, ?, ?, 'pending', ?, ?)`,
51: 					)
52: 					.run(
53: 						file.path,
54: 						file.blobSha,
55: 						file.code,
56: 						file.message,
57: 						run?.id ?? null,
58: 						input.now,
59: 						input.now,
60: 					);
61: 			}
62: 		})();
63: 		return input.files.length;
64: 	} finally {
65: 		driver.close();
66: 	}
67: };

