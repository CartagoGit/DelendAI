347: /**
348:  * The excluded files that were written as proposals. A file with no
349:  * frontmatter at all (a README beside the proposals) is not one, and
350:  * reporting it as a proposal that went missing would be noise.
351:  */
352: const proposalFilesSetAside = (
353: 	files: readonly IReconcilerInputFile[],
354: 	excluded: readonly IExcludedFile[],
355: ): readonly {
356: 	readonly path: string;
357: 	readonly blobSha: string;
358: 	readonly code: string;
359: 	readonly message: string;
360: }[] => {
361: 	const byPath = new Map(files.map((file) => [file.path, file]));
362: 	return excluded.flatMap((entry) => {
363: 		const file = byPath.get(entry.path);
364: 		if (file === undefined || !file.raw.trimStart().startsWith('---'))
365: 			return [];
366: 		return [
367: 			{
368: 				path: entry.path,
369: 				blobSha: file.sha ?? '',
370: 				code: entry.code,
371: 				message: entry.message,
372: 			},
373: 		];
374: 	});
375: };
376:
377: /**
378:  * Pure pre-flight: parse every file with the SAME reconciler the real
379:  * run uses, and split the set into what the projection accepts and what
380:  * it does not. Nothing is written; nothing is hidden — every rejected
381:  * file comes back in `excluded` with a code and a reason.
382:  */
383: export const preflightProposalFiles = (
384: 	files: readonly IReconcilerInputFile[],
385: 	sourceCommit: string,
386: ): IPreflightResult => {
387: 	const preview = reconcileProposalMarkdown({
388: 		sourceCommit,
389: 		files,
390: 		mode: 'shadow',
391: 	});
392: 	const excluded: IExcludedFile[] = preview.quarantined.map((entry) => ({
393: 		path: entry.path,
394: 		code: 'unparseable' as const,
395: 		message: `${entry.errorCode}: ${entry.errorMessage}`,
396: 	}));
397: 	// Two proposals may not share a uid. `ProposalRepo.upsertProjection`
398: 	// would quietly collapse them, but `PlanRepo.create` is a plain
399: 	// INSERT, so a duplicated id aborts the whole staging transaction with
400: 	// `UNIQUE constraint failed: plans.uid`. The winner is the first in
401: 	// the reconciler's canonical (uid, path) order, which makes the choice
402: 	// independent of the order the files were read in; every loser is
403: 	// reported by path so the duplicate is visible and fixable.
404: 	const seenUids = new Map<string, string>();
405: 	for (const candidate of preview.proposals) {
406: 		const verdict = classifyCandidate(candidate);
407: 		if (verdict !== null) {
408: 			excluded.push(verdict);
409: 			continue;
410: 		}
411: 		const winner = seenUids.get(candidate.uid);
412: 		if (winner !== undefined) {
413: 			excluded.push({
414: 				path: candidate.path,
415: 				code: 'duplicate_id',
416: 				message: `id "${candidate.uid}" is already claimed by ${winner}`,
417: 			});
418: 			continue;
419: 		}
420: 		seenUids.set(candidate.uid, candidate.path);
421: 	}
422: 	const rejectedPaths = new Set(excluded.map((entry) => entry.path));
423: 	return {
424: 		accepted: files.filter((file) => !rejectedPaths.has(file.path)),
425: 		excluded: excluded.sort((a, b) => a.path.localeCompare(b.path)),
426: 	};
427: };

