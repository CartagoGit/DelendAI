264: export const reconcileProposalMarkdown = (
265: 	input: IMarkdownReconcileInput,
266: ): IReconcileResult => {
267: 	const proposals: IProposalCandidate[] = [];
268: 	const plans: IPlanCandidate[] = [];
269: 	const slices: ISliceCandidate[] = [];
270: 	const quarantined: IQuarantineCandidate[] = [];
271: 	for (const file of input.files) {
272: 		try {
273: 			const parsed = parseProposalMarkdown(file.path, file.raw);
274: 			const identity = resolveProposalIdentity(parsed);
275: 			if ('reason' in identity) {
276: 				quarantined.push(toQuarantine(identity));
277: 				continue;
278: 			}
279: 			const candidate = toCandidate(identity, parsed);
280: 			const violation = vocabularyViolation(candidate, parsed);
281: 			if (violation !== null) {
282: 				quarantined.push(violation);
283: 				continue;
284: 			}
285: 			proposals.push(candidate);
286: 			const projected = projectPlanAndSlices(identity, parsed);
287: 			if (projected.plan !== null) plans.push(projected.plan);
288: 			slices.push(...projected.slices);
289: 		} catch (error) {
290: 			quarantined.push({
291: 				path: file.path,
292: 				errorCode: 'parse_failed',
293: 				errorMessage:
294: 					error instanceof Error ? error.message : String(error),
295: 			});
296: 		}
297: 	}
298: 	const orderedProposals = canonicalProposalCandidates(proposals);
299: 	const orderedPlans = canonicalPlanCandidates(plans);
300: 	const orderedSlices = canonicalSliceCandidates(slices);
301: 	const logicalDigest = digestEntityCandidates({
302: 		proposals: orderedProposals,
303: 		plans: orderedPlans,
304: 		slices: orderedSlices,
305: 	});
306: 	return {
307: 		mode: input.mode,
308: 		sourceCommit: input.sourceCommit,
309: 		filesSeen: input.files.length,
310: 		proposals: orderedProposals,
311: 		plans: orderedPlans,
312: 		slices: orderedSlices,
313: 		quarantined,
314: 		logicalDigest,
315: 		status: quarantined.length === 0 ? 'ok' : 'degraded',
316: 	};
317: };

