70: export interface IDbDoctorToolOptions {
71: 	readonly workspaceRoot: string;
72: 	readonly namespacePrefix?: string;
73: 	readonly checks?: readonly IDoctorCheckFn[];
74: 	/** Environment the index source switch is read from; defaults to `process.env`. */
75: 	readonly env?: Readonly<Record<string, string | undefined>>;
76: 	/** DIP seam for the SQL checks runner; defaults to the real one, which needs `bun:sqlite`. */
77: 	readonly runDoctor?: (options: IDbDoctorOptions) => IDbDoctorResult;
78: }
