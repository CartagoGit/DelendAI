
plugins/proposals/src/lib/services/proposal-markdown-at-commit.ts
1: // effect-boundary-authorized: the git read half of proposals_db_reconcile,
2: // which is the filesystem boundary for the proposals database. It runs git
3: // with an argv (no shell) to read one commit's tree out of the object store.
4: /**
5:  * The proposal markdown tree as a commit holds it, not as the worktree
6:  * happens to be while a reconcile reads it.
7:  *
8:  * A reconcile that walks the worktree reads whatever the files are at
9:  * each moment: a checkout, a pull or an agent writing in the middle of
10:  * the run leaves a projection no single commit ever held, attributed to
11:  * a HEAD that did not contain it. Reading the tree out of the object
12:  * store at one resolved SHA makes the projection a function of that SHA:
13:  * two runs at the same commit see the same bytes, whatever the branch or
14:  * the worktree did in between.
15:  *
16:  * The worktree stays the default elsewhere: a person's uncommitted edit
17:  * of a proposal is what the next read must return, and only the
18:  * worktree has it.
19:  */
20: import { execFileSync } from 'node:child_process';
21: import { isAbsolute, relative, sep } from 'node:path';
22:
23: import type {
24: 	IProposalMarkdownAtCommit,
25: 	IRefDrift,
26: } from '../contracts/interfaces/proposal-markdown-at-commit.interface';
27:
28: /** Room for the whole proposal tree in one `cat-file --batch` answer. */
29: const GIT_OUTPUT_LIMIT_BYTES = 268_435_456;
30:
31: const git = (
32: 	workspaceRoot: string,
33: 	args: readonly string[],
34: 	input?: Buffer,
35: ): Buffer =>
36: 	execFileSync('git', args, {
37: 		cwd: workspaceRoot,
38: 		maxBuffer: GIT_OUTPUT_LIMIT_BYTES,
39: 		stdio: ['pipe', 'pipe', 'pipe'],
40: 		...(input === undefined ? {} : { input }),
41: 	});
42:
43: /**
44:  * The commit `ref` names, resolved once. A ref that looks like an option
45:  * is refused rather than passed to git, and `--end-of-options` keeps any
46:  * other spelling from being read as one.
47:  */
48: export const resolveCommit = (workspaceRoot: string, ref: string): string => {
49: 	if (ref.trim() === '' || ref.startsWith('-')) {
50: 		throw new Error(`not a commit reference: "${ref}"`);
51: 	}
52: 	return git(workspaceRoot, [
53: 		'rev-parse',
54: 		'--verify',
55: 		'--quiet',
56: 		'--end-of-options',
57: 		`${ref}^{commit}`,
58: 	])
59: 		.toString('utf8')
60: 		.trim();
61: };
62:
63: /**
64:  * Split `git cat-file --batch` output into the blobs it carries, in
65:  * order. Each record is `<sha> <type> <size>\n<size bytes>\n`; sizes are
66:  * bytes, so the parse walks the buffer, never a decoded string.
67:  */
68: const splitBatch = (output: Buffer): readonly Buffer[] => {
69: 	const blobs: Buffer[] = [];
70: 	let at = 0;
71: 	while (at < output.length) {
72: 		const headerEnd = output.indexOf(0x0a, at);
73: 		if (headerEnd === -1) break;
74: 		const header = output.subarray(at, headerEnd).toString('utf8');
75: 		const size = Number(header.split(' ')[2]);
76: 		if (!Number.isInteger(size)) {
77: 			throw new Error(`unexpected git cat-file header: ${header}`);
78: 		}
79: 		blobs.push(output.subarray(headerEnd + 1, headerEnd + 1 + size));
80: 		at = headerEnd + 1 + size + 1;
81: 	}
82: 	return blobs;
83: };
84:
85: /**
86:  * Every `*.md` under `proposalsDirAbs` as commit `ref` holds it, with
87:  * paths relative to that directory and sorted the way the worktree walk
88:  * sorts them, so the two sources project identically when they agree.
89:  */
90: export const collectProposalMarkdownAtCommit = (
91: 	workspaceRoot: string,
92: 	proposalsDirAbs: string,
93: 	ref: string,
94: ): IProposalMarkdownAtCommit => {
95: 	const dir = relative(workspaceRoot, proposalsDirAbs).split(sep).join('/');
96: 	if (dir === '' || dir.startsWith('..') || isAbsolute(dir)) {
97: 		throw new Error(
98: 			`the proposals directory ${proposalsDirAbs} is not inside ${workspaceRoot}`,
99: 		);
100: 	}
101: 	const sha = resolveCommit(workspaceRoot, ref);
102: 	const entries = git(workspaceRoot, [
103: 		'ls-tree',
104: 		'-r',
105: 		'-z',
106: 		'--full-tree',
107: 		sha,
108: 		'--',
109: 		dir,
110: 	])
111: 		.toString('utf8')
112: 		.split('\0')
113: 		.filter((entry) => entry.length > 0)
114: 		.map((entry) => {
115: 			const tab = entry.indexOf('\t');
116: 			const [, type, object] = entry.slice(0, tab).split(' ');
117: 			return { type, object, path: entry.slice(tab + 1) };
118: 		})
119: 		.filter(
120: 			(entry): entry is { type: string; object: string; path: string } =>
121: 				entry.type === 'blob' &&
122: 				entry.object !== undefined &&
123: 				entry.path.endsWith('.md'),
124: 		);
125: 	if (entries.length === 0) return { sha, files: [] };
126: 	const blobs = splitBatch(
127: 		git(
128: 			workspaceRoot,
129: 			['cat-file', '--batch'],
130: 			Buffer.from(`${entries.map((entry) => entry.object).join('\n')}\n`),
131: 		),
132: 	);
133: 	const files = entries.map((entry, index) => ({
134: 		path: entry.path.slice(dir.length + 1),
135: 		raw: (blobs[index] ?? Buffer.alloc(0)).toString('utf8'),
136: 	}));
137: 	return {
138: 		sha,
139: 		files: files.sort((a, b) => a.path.localeCompare(b.path)),
140: 	};
141: };
142:
143: /**
144:  * Whether `ref` still names `sha`, asked once the reconcile is done. A
145:  * SHA names itself for ever, so it never drifts; a branch or a tag that
146:  * moved, or was deleted, while the run read `sha` is reported.
147:  */
148: export const refDrift = (
149: 	workspaceRoot: string,
150: 	ref: string,
151: 	sha: string,
152: ): IRefDrift | null => {
153: 	if (ref === sha) return null;
154: 	let now: string | null;
155: 	try {
156: 		now = resolveCommit(workspaceRoot, ref);
157: 	} catch {
158: 		now = null;
159: 	}
160: 	if (now === sha) return null;
161: 	return {
162: 		from: sha,
163: 		to: now,
164: 		reason: now === null ? 'ref-gone' : 'ref-moved',
165: 	};
166: };

plugins/proposals/src/lib/services/projection-refresh.ts
1: /**
2:  * projection-refresh.ts — the second projection, refreshed by the same
3:  * act as the first.
4:  *
5:  * ## The divergence was structural
6:  *
7:  * There are two projections of the proposal markdown: the registry at
8:  * `<cacheDir>/proposals/index.json`, and the SQLite database. The reader
9:  * prefers SQLite and falls back to the registry whenever the two
10:  * disagree.
11:  *
12:  * Only one of them was ever refreshed. `sync:proposals` runs from the
13:  * pre-commit hook on every commit that touches a proposal and rebuilds
14:  * the registry; the database was refreshed only by an MCP tool nobody
15:  * invokes by hand. So every proposal added between one manual reconcile
16:  * and the next made the database staler, and the reader fell back.
17:  *
18:  * Measured on this repository, before this change:
19:  *
20:  * ```
21:  * stats: {"reads":1,"fallbacks":1,"last":"fallback-divergence","lastDivergence":12}
22:  * notices: SQLite projection diverges … serving JSON instead
23:  *          (x00583, x00585, x00587, x00589, x00590, x00591, x00592,
24:  *           x00593, x00594, x00595, x00596, x00598)
25:  * ```
26:  *
27:  * Twelve proposals — every one written that day. The shadow could never
28:  * reach parity, so the cutover it exists to justify could never happen,
29:  * and "prefer SQLite" was a preference that never once applied.
30:  *
31:  * One act refreshes both. The markdown is the source; the registry and
32:  * the database are both views of it, taken at the same moment from the
33:  * same tree, at the same commit.
34:  *
35:  * ## Why a failure here does not fail the commit
36:  *
37:  * The registry is written first and is correct on its own — the reader
38:  * falls back to it, which is exactly the behaviour this removes the NEED
39:  * for without removing the ability. A database that could not be
40:  * reconciled is a stale cache, not a lost proposal, so it is reported
41:  * and the commit proceeds. Failing the commit would trade a recoverable
42:  * staleness for an unrecoverable interruption.
43:  */
44: import { join } from 'node:path';
45:
46: import type { IProjectionRefresh } from '../contracts/interfaces/projection-refresh.interface';
47: import { projectionParity } from '../proposals/index-reader-parity';
48: import { reconcileProposalsDb } from '../tools/db-reconcile.tool';
49:
50: export type { IProjectionRefresh } from '../contracts/interfaces/projection-refresh.interface';
51:
52: /**
53:  * Bring the SQLite projection up to the same markdown the registry was
54:  * just built from. Never throws.
55:  */
56: export const reconcileProjection = (input: {
57: 	readonly root: string;
58: 	/** Repository-relative proposals directory, from the path layout. */
59: 	readonly proposalsDir: string;
60: 	/** Injected in tests; the real reconciler by default. */
61: 	readonly reconcile?: typeof reconcileProposalsDb;
62: }): IProjectionRefresh => {
63: 	const reconcile = input.reconcile ?? reconcileProposalsDb;
64: 	try {
65: 		const output = reconcile({
66: 			workspaceRoot: input.root,
67: 			proposalsDirAbs: join(input.root, input.proposalsDir),
68: 		});
69: 		// A reconcile that ran and refused to promote is not a refresh.
70: 		// It used to be reported as one, so a projection the reader would
71: 		// keep rejecting was announced as brought level.
72: 		if (output.status !== 'ok') {
73: 			return {
74: 				status: 'failed',
75: 				lines: [
76: 					`sync:proposals  the sqlite projection was NOT refreshed: ${output.reason ?? 'the reconciler rejected the candidate'}`,
77: 					'                The registry is written and correct; the reader falls back to it.',
78: 				],
79: 			};
80: 		}
81: 		return {
82: 			status: 'refreshed',
83: 			lines: [
84: 				`sync:proposals  sqlite projection: ${String(output.filesReconciled)} of ${String(output.filesScanned)} file(s) at ${output.sourceCommit.slice(0, 9)}`,
85: 				...(output.excluded.length === 0
86: 					? []
87: 					: [
88: 							`                ${String(output.excluded.length)} excluded: ${output.excluded
89: 								.slice(0, 3)
90: 								.map((entry) => entry.path)
91: 								.join(
92: 									', ',
93: 								)}${output.excluded.length > 3 ? ' …' : ''}`,
94: 						]),
95: 			],
96: 		};
97: 	} catch (error) {
98: 		return {
99: 			status: 'failed',
100: 			lines: [
101: 				`sync:proposals  the sqlite projection was NOT refreshed: ${error instanceof Error ? error.message : String(error)}`,
102: 				'                The registry is written and correct; the reader falls back to it.',
103: 				'                Fix with: bun run sync:proposals',
104: 			],
105: 		};
106: 	}
107: };
108:
109: /**
110:  * Bring the SQLite projection level with the registry just written, and
111:  * only when it is not.
112:  *
113:  * This is what every writer of the registry calls, through
114:  * `syncProposalRegistry`, so no path that changes a proposal can leave
115:  * the database behind. It used to be called from two places with two
116:  * rules — the MCP tool refreshed when the registry changed, the commit
117:  * hook refreshed whenever there were no errors — while the seven tools
118:  * that transition, create or close a proposal refreshed the registry
119:  * alone. A transition made over MCP therefore always left the reader
120:  * falling back to JSON until the next commit, and in a project with no
121:  * commit hook, until someone ran the sync by hand.
122:  *
123:  * "Level" is the reader's own verdict (`projectionParity`), so the
124:  * writer refreshes in exactly the cases the reader would otherwise fall
125:  * back. A full reconcile costs seconds whether or not anything changed,
126:  * which is why asking first matters: the question is a pair of reads.
127:  */
128: export const levelProjection = async (input: {
129: 	readonly root: string;
130: 	readonly indexPathAbs: string;
131: 	/** Repository-relative proposals directory, from the path layout. */
132: 	readonly proposalsDir: string;
133: 	/** Injected in tests; the reader's own verdict by default. */
134: 	readonly parity?: typeof projectionParity;
135: 	/** Injected in tests; the real reconciler by default. */
136: 	readonly reconcile?: typeof reconcileProposalsDb;
137: }): Promise<IProjectionRefresh> => {
138: 	const parity = input.parity ?? projectionParity;
139: 	let verdict: Awaited<ReturnType<typeof projectionParity>>;
140: 	try {
141: 		verdict = await parity(input.indexPathAbs, {
142: 			workspaceRoot: input.root,
143: 		});
144: 	} catch {
145: 		// A parity question that cannot be answered is not an answer of
146: 		// "level": refresh, which never throws, and let it say what failed.
147: 		verdict = 'unavailable';
148: 	}
149: 	if (verdict === 'parity') return { status: 'skipped', lines: [] };
150: 	return reconcileProjection({
151: 		root: input.root,
152: 		proposalsDir: input.proposalsDir,
153: 		...(input.reconcile === undefined
154: 			? {}
155: 			: { reconcile: input.reconcile }),
156: 	});
157: };

plugins/proposals/src/lib/services/db-rebuild.ts
1: // effect-boundary-authorized: existsSync guards the bun:sqlite open. The
2: // driver opens the database file itself, outside ctx.effects, so mediating
3: // only the existence probe would suggest a supervision that does not exist.
4:
5: import { existsSync } from 'node:fs';
6:
7: import {
8: 	OutboxRepo,
9: 	ProposalsSqliteDriver,
10: 	resolveProposalsDbPaths,
11: } from '@delendai/proposals-sqlite';
12:
13: import {
14: 	reconcileProposalsDb,
15: 	resolveHeadCommit,
16: 	type IDbReconcileOutput,
17: } from '../tools/db-reconcile.tool';
18:
19: export interface IDbRebuildInput {
20: 	readonly workspaceRoot: string;
21: 	readonly proposalsDirAbs: string;
22: 	readonly apply?: boolean;
23: 	readonly confirm?: string;
24: 	readonly sourceCommit?: string;
25: 	readonly now?: number;
26: }
27:
28: export type IDbRebuildOutput = IDbReconcileOutput & {
29: 	readonly applied: boolean;
30: 	readonly proposedSha: string;
31: 	readonly confirmationRequired: boolean;
32: };
33:
34: const preview = (
35: 	input: IDbRebuildInput,
36: 	proposedSha: string,
37: ): IDbRebuildOutput => {
38: 	const output = reconcileProposalsDb({
39: 		workspaceRoot: input.workspaceRoot,
40: 		proposalsDirAbs: input.proposalsDirAbs,
41: 		sourceCommit: proposedSha,
42: 		dryRun: true,
43: 		...(input.now !== undefined ? { now: input.now } : {}),
44: 	});
45: 	return {
46: 		...output,
47: 		applied: false,
48: 		proposedSha,
49: 		confirmationRequired: input.apply === true,
50: 	};
51: };
52:
53: export const rebuildProposalsDb = (
54: 	input: IDbRebuildInput,
55: ): IDbRebuildOutput => {
56: 	const proposedSha =
57: 		input.sourceCommit ?? resolveHeadCommit(input.workspaceRoot);
58: 	if (input.apply !== true || input.confirm === undefined) {
59: 		return preview(input, proposedSha);
60: 	}
61: 	if (input.confirm !== proposedSha) {
62: 		const output = preview(input, proposedSha);
63: 		return {
64: 			...output,
65: 			status: 'rejected',
66: 			reason: `confirmation SHA does not match proposed SHA ${proposedSha}`,
67: 			confirmationRequired: true,
68: 		};
69: 	}
70:
71: 	const output = reconcileProposalsDb({
72: 		workspaceRoot: input.workspaceRoot,
73: 		proposalsDirAbs: input.proposalsDirAbs,
74: 		sourceCommit: proposedSha,
75: 		...(input.now !== undefined ? { now: input.now } : {}),
76: 	});
77: 	if (output.status === 'ok' && existsSync(output.databasePath)) {
78: 		const driver = new ProposalsSqliteDriver({ path: output.databasePath });
79: 		try {
80: 			new OutboxRepo(driver.handle).enqueue({
81: 				idempotencyKey: `db-rebuild:${proposedSha}:${output.logicalDigest ?? 'none'}`,
82: 				kind: 'proposals-db-rebuilt',
83: 				payload: JSON.stringify({
84: 					sourceCommit: proposedSha,
85: 					logicalDigest: output.logicalDigest,
86: 				}),
87: 				...(input.now !== undefined ? { now: input.now } : {}),
88: 			});
89: 		} finally {
90: 			driver.close();
91: 		}
92: 	}
93: 	return {
94: 		...output,
95: 		applied: output.status === 'ok',
96: 		proposedSha,
97: 		confirmationRequired: false,
98: 	};
99: };
100:
101: export const dbRebuildPaths = (workspaceRoot: string) =>
102: 	resolveProposalsDbPaths(workspaceRoot);
