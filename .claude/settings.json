{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",

	"permissions": {
		"allow": [
			"Read",
			"Edit",
			"Write",
			"NotebookEdit",
			"WebFetch(domain:*)",
			"WebSearch",
			"Bash",
			"Bash(gh api:*)",
			"Bash(gh pr:*)",
			"Bash(gh release:*)",
			"Bash(git push:*)",
			"Bash(git tag:*)",
			"Bash(git fetch:*)",
			"BashOutput",
			"KillShell",
			"Glob",
			"Grep",
			"Task",
			"TodoWrite",
			"Skill",
			"Skill(code-review)",
			"Skill(code-review:*)"
		],
		"deny": [],
		"defaultMode": "acceptEdits",
		"additionalDirectories": ["/home/cartago/_projects/delendai"]
	},

	"skipDangerousModePermissionPrompt": true,

	"defaultMode": "bypassPermissions",

	"env": {
		"BUN_NO_PROMPT": "1",
		"CI": "1"
	},

	"mcpServers": {}
}
