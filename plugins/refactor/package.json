{
	"name": "@mcp-vertex/refactor",
	"version": "0.1.0",
	"type": "module",
	"description": "AST-safe refactor plugin for @mcp-vertex/core: navigation (references/definition/symbols), safe rename, and rule-based codemods with dry-run diffs. Load with `mcp-vertex --plugins=refactor`.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"refactor",
		"ast",
		"ts-morph",
		"ast-grep",
		"agent",
		"ai",
		"cartago"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@mcp-vertex/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@mcp-vertex/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@mcp-vertex/core": "workspace:*"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"devDependencies": {
		"typescript": "7.0.2"
	}
}
