{
	"name": "@delendai/database",
	"version": "0.1.1",
	"type": "module",
	"description": "Database introspection + query tools (f00128).",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"database",
		"schema",
		"agent",
		"ai",
		"cartago"
	],
	"sideEffects": false,
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"check": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/database"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1",
		"better-sqlite3": "^11.0.0"
	},
	"peerDependenciesMeta": {
		"better-sqlite3": {
			"optional": true
		}
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.1.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
