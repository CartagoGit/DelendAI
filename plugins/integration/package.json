{
	"name": "@delendai/integration",
	"version": "0.3.0",
	"type": "module",
	"description": "Integration for @delendai/core: from a ready pull request to a merged commit and a told session, proven by a rehearsal on the real forge. Load with `delendai --plugins=integration`.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"integration",
		"pull-request",
		"rehearsal",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/integration"
	},
	"peerDependencies": {
		"@delendai/core": "^0.3.0"
	},
	"dependencies": {
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@delendai/test-kit": "workspace:*",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
