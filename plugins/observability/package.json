{
	"name": "@mcp-vertex/observability",
	"version": "0.1.1",
	"type": "module",
	"description": "Remote error, trace and release-health reads from Sentry/Datadog (read-only) via the allow-listed web-fetch engine; correlates with local logs/metrics in S3.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"observability",
		"sentry",
		"datadog",
		"errors",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@mcp-vertex/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"types": "./src/public/index.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --emitDeclarationOnly false",
		"check": "tsc --noEmit && biome check src",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@mcp-vertex/core": "^0.1.1",
		"@mcp-vertex/web-fetch": "workspace:*"
	},
	"devDependencies": {
		"@mcp-vertex/test-kit": "workspace:*"
	}
}
