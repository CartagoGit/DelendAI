{
	"name": "@delendai/skills-pack",
	"version": "0.1.1",
	"type": "module",
	"description": "Skills pack plugin for @delendai/core: debugging, performance, PR review, security hardening, incident response, and migration playbooks. Pure guidance, no execution.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"skills",
		"playbook",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"skills",
		"README.md"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/skills-pack",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
