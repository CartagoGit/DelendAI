{
	"name": "@delendai/orchestrator-runner",
	"version": "0.1.1",
	"type": "module",
	"description": "Routes a task to a model provider for @delendai/core: healthchecks the installed providers, scores them against the task's capability hints, and runs the chosen one (CLI, API or MCP server) under spend limits, a confirmation gate and, when configured, an execution environment it prepares and releases.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"orchestrator",
		"routing",
		"multi-model",
		"provider",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"resources",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/orchestrator-runner"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1",
		"@delendai/execution-env": "^0.1.0"
	},
	"peerDependenciesMeta": {
		"@delendai/execution-env": {
			"optional": true
		}
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.31.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
