{
	"name": "@delendai/api",
	"version": "0.1.1",
	"type": "module",
	"description": "OpenAPI-aware request building, contract validation and mocking on top of the allow-listed web-fetch engine.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"api",
		"openapi",
		"swagger",
		"contract-testing",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/api",
		"check": "tsc --noEmit && biome check src",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1",
		"@delendai/web-fetch": "workspace:*"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delendai/test-kit": "workspace:*"
	}
}
