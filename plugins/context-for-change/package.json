{
	"name": "@delendai/context-for-change",
	"version": "0.1.0",
	"type": "module",
	"description": "Compact task-oriented context orchestration for @delendai/core: combines diff, symbols, references, tests, docs and conventions into one bounded `context_for_change` tool.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"context",
		"orchestration",
		"agent",
		"ai",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/context-for-change"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"dependencies": {
		"@delendai/conventions": "workspace:*",
		"@delendai/docs": "workspace:*",
		"@delendai/git": "workspace:*",
		"@delendai/memory": "workspace:*",
		"@delendai/refactor": "workspace:*",
		"@delendai/search": "workspace:*",
		"@delendai/test-policy": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delendai/conventions": "workspace:*",
		"@delendai/core": "workspace:*",
		"@delendai/docs": "workspace:*",
		"@delendai/git": "workspace:*",
		"@delendai/memory": "workspace:*",
		"@delendai/refactor": "workspace:*",
		"@delendai/search": "workspace:*",
		"@delendai/test-policy": "workspace:*",
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
