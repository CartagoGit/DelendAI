{
	"name": "@delendai/agent-orchestrator",
	"version": "0.1.0",
	"type": "module",
	"description": "Workflow policy plugin for @delendai/core: decides whether the main agent works task-by-task (linear), spawns parallel subagents (swarm), does it all alone (single), or classifies per-task and routes accordingly (auto, default). Enforces token budgets, iteration caps, and mid-task subagent rotation when a subordinate goes off-rails. Defaults to the strategy configured in mcp-vertex.config.json, with `auto` as the project-wide default.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"agent",
		"orchestration",
		"subagent",
		"swarm",
		"policy",
		"cartago",
		"plugin"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts plugins/agent-orchestrator"
	},
	"peerDependencies": {
		"@delendai/core": "^0.1.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
