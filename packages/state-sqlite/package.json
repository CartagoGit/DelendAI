{
	"name": "@delendai/state-sqlite",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"description": "SQLite-specific helpers for the delendai state engine.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"delendai",
		"state-engine",
		"sqlite",
		"shadow-driver"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./error-method": {
			"@delendai/source": {
				"types": "./src/lib/error-method.ts"
			},
			"types": "./dist/lib/error-method.d.ts",
			"import": "./dist/lib/error-method.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "bun ../../tools/scripts/compile/build.script.ts packages/state-sqlite"
	},
	"dependencies": {
		"@delendai/state": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}