{
	"name": "@delendai/ui-extension",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"license": "BSD-3-Clause",
	"description": "Host-agnostic UI shell (dashboard, panels, command palette, brand assets) consumed by every @delendai extension host (vscode today; jetbrains, zed, cursor, antigravity tomorrow). Pure HTML + CSS + vanilla JS, no host imports.",
	"scripts": {
		"type": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"lint": "biome ci src tests"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		},
		"./webview": {
			"types": "./src/webview/index.ts",
			"import": "./src/webview/index.ts"
		},
		"./legacy": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./components/*": {
			"types": "./src/components/*.ts",
			"import": "./src/components/*.ts"
		}
	},
	"dependencies": {
		"@delendai/client": "workspace:*",
		"@delendai/shared": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "latest",
		"@types/node": "^26.1.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
