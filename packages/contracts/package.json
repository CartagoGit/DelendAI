{
	"name": "@delendai/contracts",
	"version": "0.1.1",
	"type": "module",
	"description": "Pure-TypeScript type-only contracts shared across the mcp-vertex ecosystem. NO Node imports, NO @delendai/core dependency. Plugins and external consumers can depend on this package without dragging in the runtime weight of `@delendai/core`.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"contracts",
		"types",
		"cartago"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugin": {
			"@delendai/source": {
				"types": "./src/plugin.ts"
			},
			"types": "./dist/plugin.d.ts",
			"import": "./dist/plugin.js"
		},
		"./capabilities": {
			"@delendai/source": {
				"types": "./src/capabilities.ts"
			},
			"types": "./dist/capabilities.d.ts",
			"import": "./dist/capabilities.js"
		},
		"./envelopes": {
			"@delendai/source": {
				"types": "./src/envelopes.ts"
			},
			"types": "./dist/envelopes.d.ts",
			"import": "./dist/envelopes.js"
		},
		"./safety": {
			"@delendai/source": {
				"types": "./src/safety.ts"
			},
			"types": "./dist/safety.d.ts",
			"import": "./dist/safety.js"
		},
		"./routes": {
			"@delendai/source": {
				"types": "./src/routes.ts"
			},
			"types": "./dist/routes.d.ts",
			"import": "./dist/routes.js"
		},
		"./remote-provider": {
			"@delendai/source": {
				"types": "./src/remote-provider.ts"
			},
			"types": "./dist/remote-provider.d.ts",
			"import": "./dist/remote-provider.js"
		},
		"./remote-mutations": {
			"@delendai/source": {
				"types": "./src/remote-mutations.ts"
			},
			"types": "./dist/remote-mutations.d.ts",
			"import": "./dist/remote-mutations.js"
		},
		"./remote-diagnostics": {
			"@delendai/source": {
				"types": "./src/remote-diagnostics.ts"
			},
			"types": "./dist/remote-diagnostics.d.ts",
			"import": "./dist/remote-diagnostics.js"
		},
		"./primitives": {
			"@delendai/source": {
				"types": "./src/primitives.ts"
			},
			"types": "./dist/primitives.d.ts",
			"import": "./dist/primitives.js"
		},
		"./capability-graph": {
			"@delendai/source": {
				"types": "./src/capability-graph.interface.ts"
			},
			"types": "./dist/capability-graph.interface.d.ts",
			"import": "./dist/capability-graph.interface.js"
		},
		"./host": {
			"@delendai/source": {
				"types": "./src/host-capability-manifest.interface.ts"
			},
			"types": "./dist/host-capability-manifest.interface.d.ts",
			"import": "./dist/host-capability-manifest.interface.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts packages/contracts"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
