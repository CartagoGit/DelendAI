{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"cacheDir": {
			"type": "string"
		},
		"docsDir": {
			"type": "string"
		},
		"keepLegacy": {
			"type": "boolean"
		},
		"agentWorktree": {
			"type": "boolean"
		},
		"convention": {
			"type": "object",
			"properties": {
				"pluginPathsRoot": {
					"type": "string"
				},
				"sourceRoot": {
					"type": "string"
				}
			},
			"required": [
				"pluginPathsRoot",
				"sourceRoot"
			],
			"additionalProperties": false
		},
		"filesystem": {
			"type": "object",
			"properties": {
				"authorizedRoots": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"commitAuthor": {
			"type": "object",
			"properties": {
				"mode": {
					"type": "string",
					"enum": [
						"git",
						"agent",
						"bot",
						"named"
					]
				},
				"clientName": {
					"type": "string"
				},
				"modelName": {
					"type": "string"
				},
				"humanName": {
					"type": "string"
				},
				"humanEmail": {
					"type": "string"
				}
			},
			"additionalProperties": false
		},
		"validationMatrix": {
			"type": "object",
			"properties": {
				"scopes": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"command": {
									"type": "string"
								},
								"expect": {
									"type": "string"
								}
							},
							"required": [
								"command",
								"expect"
							],
							"additionalProperties": false
						}
					}
				}
			},
			"required": [
				"scopes"
			],
			"additionalProperties": false
		},
		"plugins": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"enabled": {
						"type": "boolean"
					},
					"origin": {
						"type": "string",
						"enum": [
							"bundled",
							"user-local",
							"external"
						]
					},
					"prefix": {
						"type": "string"
					},
					"options": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"path": {
						"type": "string"
					}
				},
				"additionalProperties": false
			}
		},
		"providers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]+$",
						"description": "Unique kebab-case provider id (e.g. \"claude-sonnet\")."
					},
					"kind": {
						"type": "string",
						"enum": [
							"api",
							"subscription",
							"cli",
							"mcp-server"
						]
					},
					"invoke": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "api"
									},
									"url": {
										"type": "string"
									},
									"method": {
										"type": "string",
										"enum": [
											"GET",
											"POST"
										]
									},
									"envVar": {
										"type": "string",
										"description": "NAME of the environment variable holding the API key (e.g. \"OPENAI_API_KEY\"). Never put a literal secret here — the config file is committed."
									}
								},
								"required": [
									"kind",
									"url",
									"envVar"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "subscription"
									},
									"tool": {
										"type": "string",
										"enum": [
											"vscode-copilot",
											"claude-code",
											"codex",
											"cursor"
										]
									}
								},
								"required": [
									"kind",
									"tool"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "cli"
									},
									"command": {
										"type": "string"
									},
									"args": {
										"type": "array",
										"items": {
											"type": "string"
										}
									}
								},
								"required": [
									"kind",
									"command"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"kind": {
										"type": "string",
										"const": "mcp-server"
									},
									"server": {
										"type": "string"
									},
									"tool": {
										"type": "string"
									},
									"args": {
										"type": "object",
										"propertyNames": {
											"type": "string"
										},
										"additionalProperties": {}
									}
								},
								"required": [
									"kind",
									"server",
									"tool",
									"args"
								],
								"additionalProperties": false
							}
						]
					},
					"modelId": {
						"type": "string",
						"minLength": 1
					},
					"contextWindow": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"costTier": {
						"anyOf": [
							{
								"type": "number",
								"const": 1
							},
							{
								"type": "number",
								"const": 2
							},
							{
								"type": "number",
								"const": 3
							},
							{
								"type": "number",
								"const": 4
							},
							{
								"type": "number",
								"const": 5
							}
						]
					},
					"strengths": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"code-edit",
								"long-context",
								"very-long-context",
								"architecture",
								"security-audit",
								"reasoning",
								"vision",
								"fast-iteration",
								"json-strict",
								"multilingual",
								"agentic",
								"summarization"
							]
						}
					},
					"weaknesses": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"code-edit",
								"long-context",
								"very-long-context",
								"architecture",
								"security-audit",
								"reasoning",
								"vision",
								"fast-iteration",
								"json-strict",
								"multilingual",
								"agentic",
								"summarization"
							]
						}
					}
				},
				"required": [
					"id",
					"kind",
					"invoke",
					"modelId",
					"contextWindow",
					"costTier",
					"strengths",
					"weaknesses"
				],
				"additionalProperties": false
			},
			"uniqueItems": true
		},
		"cache": {
			"type": "object",
			"properties": {
				"runOnBoot": {
					"type": "string",
					"enum": [
						"dry-run",
						"apply",
						"off"
					]
				},
				"maxAgeDays": {
					"type": "number"
				},
				"worktrees": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"keepLastN": {
							"type": "number"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"loopDetector": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"repeatThreshold": {
					"type": "number"
				},
				"nearRepeatThreshold": {
					"type": "number"
				},
				"similarityThreshold": {
					"type": "number"
				},
				"idleThreshold": {
					"type": "number"
				},
				"noProgressThreshold": {
					"type": "number"
				},
				"ringSize": {
					"type": "number"
				},
				"gitCheckTools": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"handoffDir": {
					"type": "string"
				},
				"handoffTtlDays": {
					"type": "number"
				},
				"notifyOnDetect": {
					"type": "boolean"
				},
				"interactiveAgentPatterns": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"bootstrap": {
			"type": "object",
			"properties": {
				"patternOverrides": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "object",
						"properties": {
							"type": {
								"type": "string"
							},
							"describe": {
								"type": "string"
							},
							"recommendedTools": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"name": {
											"type": "string"
										},
										"description": {
											"type": "string"
										}
									},
									"required": [
										"name",
										"description"
									],
									"additionalProperties": false
								}
							},
							"recommendedPlugins": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"knowledgeHints": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						},
						"required": [
							"type",
							"describe",
							"recommendedTools",
							"recommendedPlugins",
							"knowledgeHints"
						],
						"additionalProperties": false
					}
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false,
	"$id": "https://cartagogit.github.io/mcp-vertex/mcp-vertex.config.schema.json",
	"title": "mcp-vertex.config.json",
	"description": "Configuration for @mcp-vertex/core: cache/docs roots, the quality-gate validation matrix, and per-plugin prefix/options."
}
