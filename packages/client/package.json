{
	"name": "@delendai/client",
	"version": "0.1.1",
	"type": "module",
	"description": "IDE-agnostic TypeScript client for talking to an delendai server over MCP stdio.",
	"author": "Cartago",
	"license": "BSD-3-Clause",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"client",
		"ide",
		"delendai"
	],
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@delendai/source": {
				"types": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./public": {
			"@delendai/source": {
				"types": "./src/public/index.ts"
			},
			"types": "./dist/public/index.d.ts",
			"import": "./dist/public/index.js"
		},
		"./contracts": {
			"@delendai/source": {
				"types": "./src/contracts/index.ts"
			},
			"types": "./dist/contracts/index.d.ts",
			"import": "./dist/contracts/index.js"
		},
		"./transport": {
			"@delendai/source": {
				"types": "./src/transport/index.ts"
			},
			"types": "./dist/transport/index.d.ts",
			"import": "./dist/transport/index.js"
		},
		"./node": {
			"@delendai/source": {
				"types": "./src/node/index.ts"
			},
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "bun ../../tools/scripts/compile/build.script.ts packages/client"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@delendai/core": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@delendai/core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@delendai/core": "workspace:*",
		"@types/bun": "latest",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CartagoGit/delendai"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
