---
/**
 * `apps/web/src/components/SiteFooter.astro` — wrapper around the
 * host-agnostic `renderSiteFooter()` from `@delendai/shared`
 * (f00102 S3.2).
 *
 * The wrapper is the ONLY Astro-aware seam: it resolves
 * `import.meta.env.BASE_URL`, looks up every footer label from the
 * i18n dictionary, and forwards the result into the shared
 * renderer. The renderer is pure string and is reusable from
 * non-Astro hosts (the extension webview, JetBrains, etc.).
 *
 * The `transition:persist` directive is an Astro runtime hint
 * that must live in the wrapper because the shared renderer
 * emits plain markup only — non-Astro hosts ignore the
 * attribute harmlessly while Astro respects the persistence.
 */
import {
	renderSiteFooter,
	type ISiteFooterLabels,
} from '@delendai/shared/components/ui/site-footer';
import { useTranslations, type Lang } from '#I18N/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Astro's `BASE_URL` is a per-build constant (configured in
// astro.config.mjs). In this workspace it resolves to `/`. The
// docs site is multilingual and each locale lives under its own
// path prefix (e.g. `/es/`, `/fr/`); the wrapper composes the
// locale prefix into the base href so the shared renderer can
// emit canonical URLs without knowing about Astro routing.
const rawBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const localePrefix = lang === 'en' ? '' : `/${lang}`;
const baseHref = `${rawBase}${localePrefix}/`;
const year = new Date().getFullYear();

const labels: ISiteFooterLabels = {
	tagline: t.footer.tagline,
	madeBy: t.footer.madeBy,
	sections: t.footer.sections,
	resources: t.footer.resources,
	built: t.footer.built,
	install: t.nav.install,
	tools: t.nav.tools,
	benchmarks: t.nav.benchmarks,
	plugins: t.nav.plugins,
	prompts: t.nav.prompts,
	knowledge: t.nav.knowledge,
	creatorsRepo: t.footer.creatorsRepo,
	creatorsNpm: t.footer.creatorsNpm,
};
---

<footer class="mcpv-sitefoot sitefoot" transition:persist>
	<Fragment set:html={renderSiteFooter({ lang, baseHref, year, labels })} />
</footer>
