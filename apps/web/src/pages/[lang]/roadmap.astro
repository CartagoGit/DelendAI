---
/**
 * `/[lang]/roadmap` — localized read-only roadmap page.
 *
 * Title and breadcrumb come from the standalone `roadmapBoardByLang` map
 * (not the site `ITranslations`), so this page adds no keys to the
 * 12-language site-dict gate. Mirrors `[lang]/proposals.astro`.
 */
import PageShell from '#COMPONENTS/PageShell.astro';
import RoadmapSection from '#COMPONENTS/RoadmapSection.astro';
import { roadmapBoardByLang } from '#I18N/roadmap-board';
import { langStaticPaths, localePath, resolveLang } from '#LIB/page';

export const getStaticPaths = langStaticPaths;

const lang = resolveLang(Astro.params.lang);
const tb = roadmapBoardByLang[lang];
---

<PageShell
	lang={lang}
	title={tb.title}
	base={import.meta.env.BASE_URL.replace(/\/$/, '')}
	crumbs={[{ label: tb.title, href: localePath(lang, 'roadmap') }]}
>
	<RoadmapSection lang={lang} />
</PageShell>
