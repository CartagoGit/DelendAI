---
/**
 * `/[lang]/tools/[plugin]/[tool]` — per-tool detail page (localized).
 *
 * Same routing logic as the root `tools/[plugin]/[tool].astro` but
 * emitting one path per non-English locale. `ToolPage` owns the body
 * (it already speaks i18n via `useTranslations`).
 */
import ToolPage from '#COMPONENTS/ToolPage.astro';
import Base from '#LAYOUTS/Base.astro';
import capabilities from '#MANIFESTS/capabilities.json';
import { languages, resolveLang } from '#LIB/page';

export function getStaticPaths() {
	const slugOf = (name: string) => name.replace('@delendai/', '');
	const pkgs = capabilities.packages as Array<{ name: string }>;
	const tools = capabilities.tools as Array<{
		name: string;
		namespace: string;
	}>;
	const langs = languages.map((l) => l.code).filter((c) => c !== 'en');
	// a00085: `t.namespace` is already the plugin's own short name — the
	// removed `nsFor` mapped "core" to a namespace no tool actually has,
	// so this route never generated a static path for any of the core
	// plugin's 19 tools in any non-English locale either.
	const entries = pkgs.flatMap((p) => {
		const slug = slugOf(p.name);
		return tools
			.filter((t) => t.namespace === slug)
			.map((t) => ({ plugin: slug, tool: t.name }));
	});
	return langs.flatMap((lang) =>
		entries.map(({ plugin, tool }) => ({ params: { lang, plugin, tool } })),
	);
}

const { lang, tool } = Astro.params;
const langCode = resolveLang(lang);
// a00085: same document-<title> fallback bug as the English route.
const title = `${tool} — @delendai/core`;
---

<Base lang={langCode} title={title}>
	<ToolPage lang={langCode} toolName={tool!} />
</Base>
