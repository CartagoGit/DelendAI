---
/**
 * `/plugins/[plugin]` — per-plugin detail page (English).
 *
 * PluginPage owns the body (it already speaks i18n via
 * `useTranslations`); this file just wires up the routing.
 */
import PluginPage from '#COMPONENTS/PluginPage.astro';
import Base from '#LAYOUTS/Base.astro';
import capabilities from '#MANIFESTS/capabilities.json';

export function getStaticPaths() {
	const slugOf = (name: string) => name.replace('@delendai/', '');
	const pkgs = capabilities.packages as Array<{ name: string }>;
	return pkgs.map((p) => ({ params: { plugin: slugOf(p.name) } }));
}

const { plugin } = Astro.params;
// a00085: Base's <title> falls back to the generic homepage title
// unless a page explicitly passes one — PluginPage's own computed
// title only reaches its in-body header, never the document head.
const pkg = (capabilities.packages as Array<{ name: string }>).find(
	(p) => p.name.replace('@delendai/', '') === plugin,
);
const title = pkg?.name ?? `@delendai/${plugin}`;
---

<Base lang="en" title={title}>
	<PluginPage lang="en" slug={plugin!} />
</Base>
