---
/**
 * `/proposals` — English read-only proposals board (f00097 S5).
 *
 * The default-locale entry; see `pages/[lang]/proposals.astro` for the
 * localized variant and the recipe.
 */
import ProposalsSection from '#COMPONENTS/ProposalsSection.astro';
import PageShell from '#COMPONENTS/PageShell.astro';
import { localePath } from '#LIB/page';
import { proposalBoardByLang } from '#I18N/proposals-board';

const lang = 'en' as const;
const tb = proposalBoardByLang[lang];
---

<PageShell
	lang={lang}
	title={tb.title}
	base={import.meta.env.BASE_URL.replace(/\/$/, '')}
	crumbs={[{ label: tb.title, href: localePath(lang, 'proposals') }]}
>
	<ProposalsSection lang={lang} />
</PageShell>
