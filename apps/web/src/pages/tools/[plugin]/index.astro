---
import ToolsPluginIndex from '#COMPONENTS/ToolsPluginIndex.astro';
import Base from '#LAYOUTS/Base.astro';
import capabilities from '#MANIFESTS/capabilities.json';

export function getStaticPaths() {
	const slugOf = (name: string) => name.replace('@delendai/', '');
	const pkgs = capabilities.packages as Array<{ name: string }>;
	return pkgs.map((p) => ({ params: { plugin: slugOf(p.name) } }));
}

const { plugin } = Astro.params;
// a00085: Base's <title> falls back to the generic homepage title
// unless a page explicitly passes one.
const pkg = (capabilities.packages as Array<{ name: string }>).find(
	(p) => p.name.replace('@delendai/', '') === plugin,
);
const title = `Tools — ${pkg?.name ?? `@delendai/${plugin}`}`;
---

<Base lang="en" title={title}>
	<ToolsPluginIndex lang="en" slug={plugin!} />
</Base>
