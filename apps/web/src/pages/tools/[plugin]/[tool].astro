---
/**
 * `/tools/[plugin]/[tool]` — per-tool detail page (English).
 *
 * Emits one path per (plugin × tool) combination. The English copy
 * lives at the root; every other locale lives at
 * `/[lang]/tools/[plugin]/[tool].astro`. `ToolPage` owns the body.
 */
import ToolPage from '#COMPONENTS/ToolPage.astro';
import Base from '#LAYOUTS/Base.astro';
import capabilities from '#MANIFESTS/capabilities.json';

export function getStaticPaths() {
	const slugOf = (name: string) => name.replace('@delendai/', '');
	const pkgs = capabilities.packages as Array<{ name: string }>;
	const tools = capabilities.tools as Array<{
		name: string;
		namespace: string;
	}>;
	return pkgs.flatMap((p) => {
		const slug = slugOf(p.name);
		// a00085: `t.namespace` is already the plugin's own short name —
		// the removed `nsFor` mapped "core" to a namespace no tool
		// actually has, so this route never generated a static path for
		// any of the core plugin's 19 tools (every /tools/core/<tool>
		// URL 404'd).
		return tools
			.filter((t) => t.namespace === slug)
			.map((t) => ({ params: { plugin: slug, tool: t.name } }));
	});
}

const { tool } = Astro.params;
// a00085: Base's <title> falls back to the generic homepage title
// unless a page explicitly passes one.
const title = `${tool} — @delendai/core`;
---

<Base lang="en" title={title}>
	<ToolPage lang="en" toolName={tool!} />
</Base>
