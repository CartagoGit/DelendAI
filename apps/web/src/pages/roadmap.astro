---
/**
 * `/roadmap` — English read-only roadmap page.
 *
 * The default-locale entry; see `pages/[lang]/roadmap.astro` for the
 * localized variant.
 */
import PageShell from '#COMPONENTS/PageShell.astro';
import RoadmapSection from '#COMPONENTS/RoadmapSection.astro';
import { roadmapBoardByLang } from '#I18N/roadmap-board';
import { localePath } from '#LIB/page';

const lang = 'en' as const;
const tb = roadmapBoardByLang[lang];
---

<PageShell
	lang={lang}
	title={tb.title}
	base={import.meta.env.BASE_URL.replace(/\/$/, '')}
	crumbs={[{ label: tb.title, href: localePath(lang, 'roadmap') }]}
>
	<RoadmapSection lang={lang} />
</PageShell>
