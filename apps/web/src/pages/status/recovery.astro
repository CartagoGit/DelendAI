---
import RecoveryTable from '#COMPONENTS/recovery/RecoveryTable.astro';
import Base from '#LAYOUTS/Base.astro';
import { useTranslations, type Lang } from '#I18N/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t.recovery.title} — @delendai/core`}>
	<section class="section">
		<div class="container">
			<h1>{t.recovery.title}</h1>
			<p>{t.recovery.lead}</p>
			<RecoveryTable labels={t.recovery} />
		</div>
	</section>
	<script>
		// The site is served under a base path on GitHub Pages
		// (`/delendai`), so a leading `/` here resolves against the
		// DOMAIN root and 404s. Every other link on the site already
		// goes through BASE_URL; these two were the exception.
		const base = import.meta.env.BASE_URL.replace(/\/$/, '');
		const source = new EventSource(`${base}/api/events/agent-dead`);
		source.addEventListener('agent-dead', () => {
			window.location.reload();
		});
		source.onerror = () => source.close();
	</script>
</Base>
