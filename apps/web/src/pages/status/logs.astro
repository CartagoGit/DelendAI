---
import LogTable from '#COMPONENTS/logs/LogTable.astro';
import Base from '#LAYOUTS/Base.astro';
import { useTranslations, type Lang } from '#I18N/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t.logs.page_title} — @delendai/core`}>
	<section class="section">
		<div class="container">
			<h1>{t.logs.page_title}</h1>
			<p>{t.logs.lead}</p>
			<LogTable labels={t.logs} />
		</div>
	</section>
	<script>
		// The site is served under a base path on GitHub Pages
		// (`/delendai`), so a leading `/` here resolves against the
		// DOMAIN root and 404s. Every other link on the site already
		// goes through BASE_URL; these two were the exception.
		const base = import.meta.env.BASE_URL.replace(/\/$/, '');
		const source = new EventSource(`${base}/api/events/logs`);
		source.addEventListener('logs', () => {
			source.close();
		});
		source.onerror = () => source.close();
	</script>
</Base>
