{
	"servers": {
		"mcp-vertex": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"tools/scripts/host/host-server.script.ts",
				"--workspace=${workspaceFolder}"
			]
		},
		"filesystem": {
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}"
			]
		}
	}
}
