{
	"servers": {
		"mcp-vertex": {
			"type": "stdio",
			"command": "bunx",
			"args": [
				"--package",
				"@mcp-vertex/cli",
				"mcpv",
				"__serve",
				"--workspace",
				"${workspaceFolder}"
			]
		},
		"filesystem": {
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}"
			]
		}
	}
}
