{
	"$schema": "https://unpkg.com/@mcp-vertex/core/schema/mcp-vertex.config.schema.json",
	"coreVersion": "latest-published",
	"cacheDir": ".cache/mcp-vertex",
	"docsDir": "docs/mcp-vertex",
	"agentWorktree": false,
	"commitAuthor": {
		"mode": "git"
	},
	"convention": {
		"pluginPathsRoot": "packages",
		"sourceRoot": "packages"
	},
	"plugins": {
		"git": {
			"options": {
				"allowForge": true,
				"allowWrite": true
			}
		},
		"forge": {
			"options": {}
		},
		"search": {
			"options": {
				"roots": ["packages", "plugins", "extensions", "apps", "tools"],
				"extensions": ["ts", "tsx", "js", "mjs", "cjs", "md", "json"],
				"ignoreDirs": [
					"node_modules",
					".cache",
					"dist",
					"build",
					".git"
				]
			}
		},
		"context-for-change": {
			"options": {
				"docsRoots": ["docs/mcp-vertex", "README.md"],
				"maxBytes": 3000
			}
		},
		"memory": {
			"options": {
				"bm25K1": 1.5,
				"bm25B": 0.75,
				"titleWeight": 2,
				"maxNotes": 1000
			}
		},
		"docs": {
			"options": {
				"roots": ["docs/mcp-vertex", "README.md"],
				"extensions": ["md", "mdx"],
				"ignoreDirs": ["node_modules", ".cache", "dist"]
			}
		},
		"rules": {
			"options": {}
		},
		"quality": {
			"options": {}
		},
		"deps": {
			"options": {
				"manifest": "package.json",
				"allowNetwork": true,
				"allowWrite": false
			}
		},
		"proposals": {
			"options": {
				"validationCommand": "bun run validate",
				"namePool": ["falcon", "owl", "crow", "sparrow", "finch"],
				"orchestration": {
					"delegateAfterToolCalls": 3
				},
				"persist": {
					"mode": "commit-and-push",
					"pushTarget": "origin develop"
				}
			}
		},
		"notification": {
			"options": {
				"intervalMs": 2000,
				"heartbeatMs": 30000
			}
		},
		"completion": {
			"options": {}
		},
		"logs": {
			"options": {
				"retentionCount": 10
			}
		},
		"status-marker": {
			"options": {}
		},
		"test-convention": {
			"options": {}
		},
		"test-policy": {
			"options": {}
		},
		"conventions": {
			"options": {
				"roots": ["packages", "plugins", "extensions", "apps", "tools"]
			}
		},
		"security": {
			"options": {}
		},
		"prompts-pack": {
			"options": {}
		},
		"diagram": {
			"options": {}
		},
		"env": {
			"options": {}
		},
		"error-reporting": {
			"options": {}
		},
		"i18n": {
			"options": {}
		},
		"perf": {
			"options": {}
		},
		"tech-debt": {
			"options": {}
		},
		"link-check": {
			"options": {}
		},
		"usage-tracking": {
			"options": {}
		},
		"orchestrator-runner": {
			"options": {}
		},
		"auto-agent-selector": {
			"options": {
				"costQualityTradeoff": 8
			}
		},
		"container": {
			"options": {}
		},
		"audit": {
			"options": {}
		}
	}
}
