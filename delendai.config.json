{
	"$schema": "https://unpkg.com/@delendai/core/schema/delendai.config.schema.json",
	"coreVersion": "latest-published",
	"cacheDir": ".cache/delendai",
	"docsDir": "docs/delendai",
	"agentWorktree": false,
	"core": {
		"agentPolicy": {
			"autonomous": true,
			"principles": [
				"Apply SOLID architecture where it improves ownership and changeability.",
				"Use good engineering practices and keep the code clear and maintainable.",
				"Reuse existing code and abstractions before introducing duplication.",
				"Keep naming, files, and folders homogeneous with the surrounding project."
			]
		}
	},
	"commitAuthor": {
		"mode": "git"
	},
	"surfaceMode": "managed",
	"managedSurface": {
		"loading": "lazy"
	},
	"convention": {
		"pluginPathsRoot": "packages",
		"sourceRoot": "packages"
	},
	"plugins": {
		"git": {
			"options": {
				"allowForge": true,
				"allowWrite": true,
				"allowStash": false
			}
		},
		"forge": {
			"options": {}
		},
		"search": {
			"options": {
				"roots": ["packages", "plugins", "extensions", "apps", "tools"],
				"extensions": ["ts", "tsx", "js", "mjs", "cjs", "md", "json"],
				"ignoreDirs": [
					"node_modules",
					".cache",
					"dist",
					"build",
					".git"
				]
			}
		},
		"context-for-change": {
			"options": {
				"docsRoots": ["docs/delendai", "README.md"],
				"maxBytes": 3000
			}
		},
		"impact-analysis": {
			"options": {
				"maxBytes": 3000
			}
		},
		"project-health": {
			"options": {
				"maxBytes": 2000
			}
		},
		"quality-policy": {
			"options": {
				"maxBytes": 2000
			}
		},
		"adaptive-optimizer": {
			"options": {
				"maxBytes": 2000
			}
		},
		"memory": {
			"options": {
				"bm25K1": 1.5,
				"bm25B": 0.75,
				"titleWeight": 2,
				"maxNotes": 1000
			}
		},
		"docs": {
			"options": {
				"roots": ["docs/delendai", "README.md"],
				"extensions": ["md", "mdx"],
				"ignoreDirs": ["node_modules", ".cache", "dist"]
			}
		},
		"rules": {
			"options": {}
		},
		"quality": {
			"options": {
				"scopes": {
					"all": ["bun run build"]
				}
			}
		},
		"deps": {
			"options": {
				"manifest": "package.json",
				"allowNetwork": true,
				"allowWrite": false
			}
		},
		"proposals": {
			"options": {
				"validationCommand": "bun run validate",
				"namePool": ["falcon", "owl", "crow", "sparrow", "finch"],
				"orchestration": {
					"delegateAfterToolCalls": 3
				},
				"persist": {
					"mode": "commit-and-push"
				}
			}
		},
		"notification": {
			"options": {
				"intervalMs": 2000,
				"heartbeatMs": 30000
			}
		},
		"completion": {
			"options": {}
		},
		"logs": {
			"options": {
				"retentionCount": 10
			}
		},
		"status-marker": {
			"options": {}
		},
		"test-convention": {
			"options": {}
		},
		"test-policy": {
			"options": {}
		},
		"conventions": {
			"options": {
				"roots": ["packages", "plugins", "extensions", "apps", "tools"]
			}
		},
		"security": {
			"options": {}
		},
		"diagram": {
			"options": {}
		},
		"env": {
			"options": {}
		},
		"error-reporting": {
			"options": {}
		},
		"i18n": {
			"options": {}
		},
		"perf": {
			"options": {}
		},
		"tech-debt": {
			"options": {}
		},
		"link-check": {
			"options": {}
		},
		"usage-tracking": {
			"options": {}
		},
		"project-kpis": {
			"options": {}
		},
		"orchestrator-runner": {
			"options": {}
		},
		"agent-orchestrator": {
			"options": {
				"policy": {
					"defaultMode": "auto",
					"defaults": {
						"budget": {
							"maxTokensOrchestrator": 200000,
							"maxTokensPerSubagent": 50000,
							"timeoutMs": 0
						},
						"rotation": {
							"maxIterationsPerSubagent": 3,
							"allow": [
								"token-budget-exhausted",
								"schema-violation",
								"repeated-output",
								"error-storm"
							]
						}
					}
				}
			}
		},
		"auto-agent-selector": {
			"options": {
				"costQualityTradeoff": 8
			}
		},
		"auto-plugin-selector": {
			"options": {
				"weights": {
					"match": 0.2,
					"tokenTax": 0.25,
					"latencyTax": 0.15,
					"historicalSuccess": 0.2,
					"permissionRisk": 0.2
				}
			}
		},
		"container": {
			"options": {}
		},
		"audit": {
			"options": {}
		},
		"commit-policy": {
			"options": {
				"gitTimeoutMs": 60000,
				"commit": {
					"enabled": true
				},
				"stash": {
					"enabled": false
				},
				"push": {
					"enabled": true,
					"onCommit": true,
					"force": "with-lease",
					"protectedBranches": ["main", "master"],
					"remote": "origin",
					"branch": "develop"
				},
				"cadence": {
					"triggers": [
						{
							"kind": "slice"
						},
						{
							"kind": "interval",
							"minutes": 5
						}
					],
					"sliceScoping": false,
					"allowForeignChanges": true
				},
				"identity": {
					"mode": "explicit",
					"owner": {
						"name": "Cartago",
						"email": "cartago.relaxingcup@gmail.com"
					}
				},
				"audit": {
					"trailer": "none",
					"agentFormat": "${host}/${model}"
				}
			}
		}
	}
}
